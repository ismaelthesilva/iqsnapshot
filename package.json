    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.7.0",
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^3.2.0",
    "stripe": "^14.14.0",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7"
