    "concurrently": "^9.2.1",
    "eslint": "^10.1.0",
    "eslint-config-next": "^16.2.1",
    "jsdom": "^27.2.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vitest": "^4.0.15"
